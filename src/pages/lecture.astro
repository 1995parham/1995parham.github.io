---
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";

const courses = [
	{
		title: "Internet Engineering",
		href: "https://1995parham-teaching.github.io/ie-lecture/",
		description:
			"Protocols, web architecture, and the systems behind the Internet.",
	},
	{
		title: "Introduction to Information Security",
		href: "https://1995parham-teaching.github.io/is-lecture/",
		description:
			"Foundations of information security: cryptography, authentication, and secure systems.",
	},
	{
		title: "Python 201",
		href: "https://1995parham-teaching.github.io/Python201/",
		description: "Intermediate Python for people who already know the basics.",
	},
	{
		title: "Introduction to Programming",
		href: "https://github.com/1995parham-teaching/c-lecture/",
		description: "First steps in programming, taught in C.",
	},
];
---
<Layout
	title="Lectures - Parham Alvani | Teaching & Courses"
	description="Teaching materials and courses by Parham Alvani: Internet Engineering, Introduction to Information Security, Python 201, and Introduction to Programming."
>
	<PageHeader
		eyebrow="Teaching"
		title="Lectures"
		lead="Courses I have taught, with slides, notes, and assignments published openly."
	/>

	<div class="card-grid">
		{
			courses.map((c) => (
				<a class="card" href={c.href} target="_blank" rel="noopener">
					<h2>{c.title}</h2>
					<p class="card-meta">{c.description}</p>
					<span class="card-link">
						Course homepage <Icon name="external" />
					</span>
				</a>
			))
		}
	</div>
</Layout>
