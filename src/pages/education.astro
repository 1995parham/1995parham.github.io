---
import Entry, { type Meta } from "../components/Entry.astro";
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";

// Mirrors the Education section of 1995parham.pdf.
const aut: Meta = {
	icon: "graduation-cap",
	text: "Amirkabir University of Technology, Tehran, Iran",
	href: "https://aut.ac.ir/",
};

const degrees: { title: string; meta: Meta[] }[] = [
	{
		title: "Ph.D. in Computer Network",
		meta: [
			{ icon: "calendar", text: "2019 - 2024" },
			{ icon: "star", text: "GPA 8.67/10 (17.34/20 national scale)" },
			aut,
		],
	},
	{
		title: "M.Sc. in Computer Network",
		meta: [
			{ icon: "calendar", text: "2017 - 2019" },
			{ icon: "star", text: "GPA 9.39/10 (18.77/20) — Sobresaliente" },
			aut,
		],
	},
	{
		title: "B.Sc. Computer Engineering (Software Engineering)",
		meta: [
			{ icon: "calendar", text: "2013 - 2017" },
			{ icon: "star", text: "GPA 9.47/10 (18.94/20) — Sobresaliente" },
			aut,
		],
	},
	{
		title: "High School Diploma in Mathematics and Physics",
		meta: [
			{ icon: "calendar", text: "2009 - 2013" },
			{
				icon: "graduation-cap",
				text: "Energy Atomic High School, Tehran, Iran",
			},
		],
	},
];
---
<Layout
	title="Education - Parham Alvani | Ph.D. in Computer Network"
	description="Educational background of Parham Alvani: Ph.D. and M.Sc. in Computer Network, B.Sc. in Computer Software Engineering from Amirkabir University of Technology."
>
	<PageHeader
		eyebrow="Education"
		title="Degrees"
		lead="Eleven years at Amirkabir University of Technology, from a software engineering bachelor's to a Ph.D. in computer networks."
	/>

	<div class="timeline">
		{
			degrees.map((d) => (
				<Entry title={d.title} meta={d.meta}>
					<Fragment />
				</Entry>
			))
		}
	</div>

	<p class="prose" style="margin-top: 2.5rem; color: var(--text-muted);">
		Reports and assignments from these years are available in{" "}
		<a href="https://github.com/9231058">this GitHub organization</a>.
	</p>
</Layout>
