---
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
---
<Layout
	title="Blog - Parham Alvani | Technical Articles & Tutorials"
	description="Technical blog posts by Parham Alvani covering IoT platforms, software development, cloud engineering, and programming tutorials."
>
	<PageHeader
		eyebrow="Blog"
		title="Writing"
		lead="Notes on IoT platforms, systems, and the tools I use."
	/>

	<p class="callout">
		<Icon name="newspaper" />
		<span>
			Preparing for interviews? See my{" "}
			<a
				href="https://github.com/1995parham-teaching/interviews"
				target="_blank"
				rel="noopener"
			>
				interview preparation notes
			</a>
			{" "}on GitHub.
		</span>
	</p>

	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a class="card" href={`/blog/${post.id}`}>
						<h2>{post.data.title}</h2>
						<p class="card-meta">
							<time datetime={post.data.date.toISOString()}>
								{formatDate(post.data.date)}
							</time>
						</p>
						{post.data.tags.length > 0 && (
							<ul class="tags">
								{post.data.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						)}
					</a>
				</li>
			))
		}
	</ul>
</Layout>
