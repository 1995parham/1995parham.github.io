---
import { Image } from "astro:assets";
import profile from "../assets/parham-alvani-profile.png";
import softwareEngineer from "../assets/parham-alvani-software-engineer.jpg";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

// Professional facts below mirror 1995parham.pdf (see CLAUDE.md); keep them
// in sync with the resume rather than editing them here in isolation.

let resumeTag = "latest";
try {
	const res = await fetch(
		"https://api.github.com/repos/1995parham/1995parham.pdf/releases/latest",
	);
	if (!res.ok) {
		throw new Error(`GitHub API returned ${res.status}`);
	}
	const latest = await res.json();
	resumeTag = latest.tag_name || "latest";
} catch (error) {
	console.error("Failed to fetch resume tag:", error);
}

// The `parham.pdf` asset name is literal: the resume repo publishes its
// default variant under that name specifically so this link resolves.
const resumeUrl = `https://github.com/1995parham/1995parham.pdf/releases/download/${resumeTag}/parham.pdf`;

const socials = [
	{ href: "https://github.com/1995parham", icon: "github", label: "GitHub" },
	{
		href: "https://stackoverflow.com/users/4242097/parham-alvani",
		icon: "stack-overflow",
		label: "Stack Overflow",
	},
	{
		href: "https://www.youtube.com/@parhamalvani",
		icon: "youtube",
		label: "YouTube",
	},
	{
		href: "https://www.reddit.com/user/1995parham",
		icon: "reddit",
		label: "Reddit",
	},
	{ href: "https://t.me/parham_alvani", icon: "telegram", label: "Telegram" },
] as const;

const interests = [
	"Internet of Things (IoT)",
	"Embedded Programming",
	"Cyber-Physical Systems",
	"Kernel Hacking",
	"Cloud-Native Platforms",
];

const skills = [
	"Go",
	"Python",
	"Rust",
	"Kubernetes",
	"Docker",
	"Microservices Architecture",
	"Platform Engineering",
];
---
<Layout>
	<section class="hero">
		<Image
			src={profile}
			alt="Parham Alvani"
			width={320}
			height={320}
			class="hero-avatar"
			loading="eager"
			fetchpriority="high"
		/>
		<div>
			<h1>Parham Alvani</h1>
			<p class="hero-title">Senior Software &amp; Platform Engineer</p>
			<p class="hero-location">
				<Icon name="location" /> Barcelona, Spain
			</p>
			<p class="hero-summary">
				Software engineer with a Ph.D. and over 10 years of experience building
				backend systems and cloud-native platforms. Proven expertise in Go,
				Python, Kubernetes, and microservices architecture, with hands-on
				success engineering high-throughput solutions handling 300,000+
				messages/sec.
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href={resumeUrl} target="_blank" rel="noreferrer">
					<Icon name="file-down" />
					Download CV
					<span class="btn-note">({resumeTag})</span>
				</a>
				<a class="btn" href="mailto:parham.alvani@gmail.com">
					<Icon name="envelope" />
					Email me
				</a>
				<ul class="socials">
					{
						socials.map((s) => (
							<li>
								<a href={s.href} target="_blank" rel="me noopener" title={s.label}>
									<Icon name={s.icon} label={s.label} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="section about-grid" aria-labelledby="about-title">
		<div class="prose">
			<h2 id="about-title" class="section-title">Who am I?</h2>
			<p>
				My journey began in 2012 at Amirkabir University of Technology, where my
				first programming course with{" "}
				<a href="https://ce.aut.ac.ir/~bakhshis/">Prof. Bakhshi</a>{" "}
				sparked my passion for Unix, Linux, and the world of computing.
			</p>
			<p>
				I am deeply interested in networks and their applications in Internet
				of Things. As a researcher, I love hands-on work—building real systems
				rather than theoretical models. My Ph.D. research focused on practical
				IoT solutions and network protocols.
			</p>
			<p>
				As a developer, I thrive on solving complex challenges, understanding
				root causes, and optimizing performance. My track record spans
				full-stack development, distributed systems design, and platform
				engineering—from writing production services to architecting
				company-wide infrastructure.
			</p>
			<Image
				src={softwareEngineer}
				alt="Parham Alvani"
				width={1200}
				class="photo"
			/>
		</div>
		<aside class="about-aside">
			<div>
				<h3>Interests</h3>
				<ul class="chips">
					{interests.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div>
				<h3>Key skills</h3>
				<ul class="chips">
					{skills.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</aside>
	</section>
</Layout>
